#!/usr/bin/env bash
# {{ ansible_managed }} (node/roles/tailscale_cert)
# Gets the node's Tailscale HTTPS certificate (Let's Encrypt, for its <node>.<tailnet>.ts.net name) and loads it into
# the TLS Secret {{ tailscale_cert_namespace }}/{{ tailscale_cert_secret }}, which Traefik serves on 443.
# Run daily by tailscale-cert.timer; by hand: sudo systemctl start tailscale-cert.service
# tailscaled keeps the certificate and only asks Let's Encrypt for a new one when less than
# {{ tailscale_cert_min_validity }} is left, so most runs load the same certificate and change nothing.
set -euo pipefail
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml

# The name comes from Tailscale, so it is never written in the repository.
name=$(tailscale status --self --json | jq -r '.CertDomains[0] // empty')
if [ -z "$name" ]; then
  echo "the node has no certificate name: turn on HTTPS certificates in the Tailscale admin console (DNS page)" >&2
  exit 1
fi

# The key exists only in this private directory (mktemp makes it 0700) and in the Secret.
dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
tailscale cert --min-validity {{ tailscale_cert_min_validity }} \
  --cert-file "$dir/tls.crt" --key-file "$dir/tls.key" "$name"

kubectl create secret tls {{ tailscale_cert_secret }} -n {{ tailscale_cert_namespace }} \
  --cert "$dir/tls.crt" --key "$dir/tls.key" --dry-run=client -o yaml \
  | kubectl label --local -f - -o yaml app.kubernetes.io/managed-by=home-lab-node \
  | kubectl apply -f -

openssl x509 -in "$dir/tls.crt" -noout -subject -enddate
