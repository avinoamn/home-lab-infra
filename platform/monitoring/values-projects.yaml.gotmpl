{{- /* The namespaces Grafana's sidecars load dashboards and datasources from: `monitoring` plus every project in
projects/projects.yaml with `grafana: true`. Onboarding such a project adds its namespace here (docs/onboarding.md). */ -}}
{{- $namespaces := list "monitoring" }}
{{- range .Values.projects }}
{{- if .grafana }}
{{- $namespaces = append $namespaces .name }}
{{- end }}
{{- end }}
grafana:
  sidecar:
    dashboards:
      searchNamespace: {{ $namespaces | toJson }}
    datasources:
      searchNamespace: {{ $namespaces | toJson }}
