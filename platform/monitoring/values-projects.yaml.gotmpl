{{- /* The namespaces Grafana's sidecars load dashboards and datasources from: `monitoring` plus every project in
projects/projects.yaml with `grafana: true`, and the namespaces where Grafana gets a Role to read ConfigMaps and
Secrets. Onboarding such a project adds its namespace here (docs/onboarding.md). */ -}}
{{- $namespaces := list "monitoring" }}
{{- range .Values.projects }}
{{- if .grafana }}
{{- $namespaces = append $namespaces .name }}
{{- end }}
{{- end }}
grafana:
  rbac:
    namespaces: {{ without $namespaces "monitoring" | toJson }}   # the chart adds its own namespace
  sidecar:
    dashboards:
      searchNamespace: {{ $namespaces | toJson }}
    datasources:
      searchNamespace: {{ $namespaces | toJson }}
