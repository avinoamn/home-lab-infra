    {
      "id": 15,
      "type": "stat",
      "title": "CPU requested",
      "description": "Sum of the containers' CPU requests against what the node offers. Over 100%, new pods cannot be scheduled.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_container_resource_requests{resource=\"cpu\"}) / sum(kube_node_status_allocatable{resource=\"cpu\"}) * 100",
          "legendFormat": "",
          "editorMode": "code",
          "range": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 70,
                "color": "#EAB839"
              },
              {
                "value": 90,
                "color": "red"
